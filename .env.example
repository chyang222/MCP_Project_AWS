# ──────────────────────────────────────────────
# How to obtain AWS Access Keys
# ──────────────────────────────────────────────
# 1. Log in to the AWS Console (https://console.aws.amazon.com)
#    - Enter your Account ID or alias
#    - Enter your IAM username and password
#
# 2. Go to IAM → Users → click your account
#
# 3. Click [Create access key] in the top-right area of the page
#    → Use case: Command Line Interface (CLI)
#    → Description tag: mcp-tool (optional)
#    → Click [Create access key]
#
# 4. Copy the generated values below
#    - The Secret access key is only shown once — save it immediately
#    - ACCOUNT_ID: click your name in the top-right → copy the Account ID (digits only, no dashes)
# ──────────────────────────────────────────────

# Account info (ARN format: arn:aws:iam::<ACCOUNT_ID>:user/<IAM_USERNAME>)
AWS_ACCOUNT_ID=enter-your-12-digit-account-id

AWS_ACCESS_KEY_ID=enter-your-access-key-id
AWS_SECRET_ACCESS_KEY=enter-your-secret-access-key

# Default region
AWS_DEFAULT_REGION=ap-northeast-2
