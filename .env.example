# ──────────────────────────────────────────────
# AWS Access Key 발급 방법
# ──────────────────────────────────────────────
# 1. AWS 콘솔 로그인 (https://console.aws.amazon.com)
#    - Account ID : siemenskr
#    - IAM username / Password 입력
#
# 2. IAM → IAM 사용자 → 본인 계정 클릭
#
# 3. 페이지 우측 상단 [액세스 키 만들기] 클릭
#    → 용도: Command Line Interface (CLI) 선택
#    → 설명 태그: mcp-tool (자유 입력)
#    → [액세스 키 만들기] 버튼 클릭
#
# 4. 발급된 값을 아래에 복사 붙여넣기
#    - Secret access key는 이 화면에서만 확인 가능 — 반드시 저장
     - ACCOUNT_ID는 우측 상단 클릭 후 계정 ID 복사 (숫자만/- 없애기)
# ──────────────────────────────────────────────

# 계정 정보 (ARN 기준: arn:aws:iam::351947153510:user/changhyuk.yang@siemens.com)
AWS_ACCOUNT_ID=351947153510

AWS_ACCESS_KEY_ID=여기에_액세스_키_ID_붙여넣기
AWS_SECRET_ACCESS_KEY=여기에_시크릿_액세스_키_붙여넣기

# 기본 리전
AWS_DEFAULT_REGION=ap-northeast-2
